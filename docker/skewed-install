#!/bin/bash
# skewed-install -- on-demand module installer for skewed-emacs containers.
#
# The elisp-first UI is M-x skewed-install / M-x skewed-uninstall (see
# dot-files/emacs.d/etc/skewed-install-config.el); this script is the
# baked-in engine underneath, also usable directly from a shell.
#
# Installs are ephemeral BY DESIGN: they land in the container home and
# vanish when the container is recreated.  For baked-in persistence pull
# the -aituis or -full image instead.
#
# usage: skewed-install <module>            install a module
#        skewed-install remove <module>     uninstall a module
#        skewed-install list               show modules + install status
set -euo pipefail

MODULES="claude-code codex gemini-cli grok copilot-language-server headless-shell"

usage() {
  cat <<EOF
usage: skewed-install <module> | remove <module> | list
modules:
  claude-code              Anthropic Claude Code TUI (npm, ~300MB)
  codex                    OpenAI Codex TUI (npm, ~300MB)
  gemini-cli               Google Gemini CLI (npm, ~130MB)
  grok                     xAI Grok CLI (binary installer, ~160MB)
  copilot-language-server  GitHub Copilot LSP server (npm, ~70MB)
  headless-shell           chrome-headless-shell + libs for webshot (~610MB)
EOF
}

npm_module() {  # npm_module <home-dir-name> <package> <bin-name...>
  local dir="$1" pkg="$2"; shift 2
  mkdir -p "$HOME/.$dir/local" "$HOME/.local/bin"
  npm install --omit=dev "$pkg" --prefix "$HOME/.$dir/local"
  local bin
  for bin in "$@"; do
    ln -sf "$HOME/.$dir/local/node_modules/.bin/$bin" "$HOME/.local/bin/$bin"
  done
  npm cache clean --force >/dev/null 2>&1 || true
}

npm_module_remove() {  # npm_module_remove <home-dir-name> <bin-name...>
  local dir="$1"; shift
  rm -rf "$HOME/.$dir/local"
  local bin
  for bin in "$@"; do rm -f "$HOME/.local/bin/$bin"; done
}

install_module() {
  case "$1" in
    claude-code) npm_module claude @anthropic-ai/claude-code claude ;;
    codex)       npm_module codex @openai/codex codex ;;
    gemini-cli)  npm_module gemini @google/gemini-cli gemini ;;
    grok)
      mkdir -p "$HOME/.grok/bin" "$HOME/.grok/downloads" "$HOME/.local/bin"
      curl -fsSL https://x.ai/cli/install.sh | bash
      ln -sfn "$HOME/.grok/bin/grok" "$HOME/.local/bin/grok"
      ln -sfn "$HOME/.grok/bin/agent" "$HOME/.local/bin/agent"
      ;;
    copilot-language-server)
      npm_module copilot @github/copilot-language-server copilot-language-server
      ;;
    headless-shell)
      if command -v chrome-headless-shell >/dev/null 2>&1; then
        echo "chrome-headless-shell already present ($(command -v chrome-headless-shell))"
        return 0
      fi
      echo "Installing shared-library closure (sudo apt-get)..."
      sudo apt-get update
      sudo apt-get install -y --no-install-recommends \
        libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 \
        libasound2 libatk1.0-0 libatk-bridge2.0-0 libatspi2.0-0 \
        libdbus-1-3 libexpat1 libgbm1 libglib2.0-0 libnspr4 libnss3 \
        libxcb1 libxkbcommon0 \
        fontconfig fonts-liberation fonts-noto-core fonts-noto-color-emoji \
        fonts-noto-mono
      sudo rm -rf /var/lib/apt/lists/*
      fc-cache -f || true
      echo "Downloading chrome-headless-shell (playwright build)..."
      PLAYWRIGHT_BROWSERS_PATH="$HOME/.cache/ms-playwright" \
        npx -y playwright-core install chromium-headless-shell
      local shell_bin
      shell_bin="$(find "$HOME/.cache/ms-playwright" -type f \
        \( -name chrome-headless-shell -o -name headless_shell \) | head -1)"
      test -n "$shell_bin"
      mkdir -p "$HOME/.local/bin"
      ln -sf "$shell_bin" "$HOME/.local/bin/chrome-headless-shell"
      "$HOME/.local/bin/chrome-headless-shell" --version
      ;;
    *) echo "Unknown module: $1" >&2; usage >&2; exit 1 ;;
  esac
  echo "✓ $1 installed"
}

remove_module() {
  case "$1" in
    claude-code) npm_module_remove claude claude ;;
    codex)       npm_module_remove codex codex ;;
    gemini-cli)  npm_module_remove gemini gemini ;;
    grok)        rm -rf "$HOME/.grok"; rm -f "$HOME/.local/bin/grok" "$HOME/.local/bin/agent" ;;
    copilot-language-server) npm_module_remove copilot copilot-language-server ;;
    headless-shell)
      rm -rf "$HOME/.cache/ms-playwright"
      rm -f "$HOME/.local/bin/chrome-headless-shell"
      echo "(apt-installed libraries left in place)"
      ;;
    *) echo "Unknown module: $1" >&2; usage >&2; exit 1 ;;
  esac
  echo "✓ $1 removed"
}

status_of() {
  local bin
  case "$1" in
    claude-code) bin=claude ;;
    codex) bin=codex ;;
    gemini-cli) bin=gemini ;;
    grok) bin=grok ;;
    copilot-language-server) bin=copilot-language-server ;;
    headless-shell) bin=chrome-headless-shell ;;
  esac
  if command -v "$bin" >/dev/null 2>&1; then echo "installed"; else echo "-"; fi
}

case "${1:-}" in
  ""|-h|--help) usage ;;
  list|--list)
    for m in $MODULES; do printf "%-26s %s\n" "$m" "$(status_of "$m")"; done
    ;;
  remove|--remove|uninstall)
    [ -n "${2:-}" ] || { usage >&2; exit 1; }
    remove_module "$2"
    ;;
  *) install_module "$1" ;;
esac
