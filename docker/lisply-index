# lisply-index: build a Lisply corpus file (lisply-mcp CORPUS.md) with
# the reference indexer that ships inside this image with lisply-mcp.
# Any project can run it from the image in its own CI:
#
#   docker run --rm -v "$PWD:/corpus:ro" -v "$PWD/out:/out" \
#     gornskew/readymax:devo-lite lisply-index --root /corpus --out /out/<name>.sexp
#
# and the yard runs it aboard the ready room to index mounted source.

set -euo pipefail
exec node /home/emacs-user/lisply-mcp/scripts/lisply-index.js "$@"
