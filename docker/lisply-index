# lisply-index: build a Lisply corpus file (lisply-mcp CORPUS.md) with
# the reference indexer that ships inside this image with lisply-mcp.
# Any project can run it from the image in its own CI:
#
#   docker run --rm --entrypoint lisply-index -v "$PWD:/corpus:ro" -v "$PWD/out:/out" \
#     gornskew/readymax:devo-lite --root /corpus --out /out/<name>.sexp
#
# (--entrypoint, because the image's own entrypoint starts the console
# and ignores the command), and the yard runs it aboard the ready room
# with docker exec to index mounted source.

set -euo pipefail
# The world-readable copy first (so `docker run --user <any uid>' can
# run it: the image user's home is 0700); the clone's own as fallback
# for an image built before the copy existed.
for script in /usr/local/lib/lisply/lisply-index.js /home/emacs-user/lisply-mcp/scripts/lisply-index.js; do
  if [ -r "$script" ]; then exec node "$script" "$@"; fi
done
echo "lisply-index: the reference indexer is not in this image" >&2
exit 1
