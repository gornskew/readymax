[Unit]
Description=Skewed Emacs + Gendl Containerized Development Environment
Documentation=https://github.com/gornskew/skewed-emacs
After=docker.service network-online.target
Requires=docker.service network.target    # added network.target for extra safety
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=%%USER%%
Group=docker
WorkingDirectory=/home/%%USER%%/projects/skewed-emacs
Environment=HOME=/home/%%USER%%

ExecStartPre=/home/%%USER%%/projects/skewed-emacs/compose-dev init

ExecStart=/home/%%USER%%/projects/skewed-emacs/compose-dev up -d

ExecStop=/home/%%USER%%/projects/skewed-emacs/compose-dev down

ExecReload=/home/%%USER%%/projects/skewed-emacs/compose-dev restart

TimeoutStartSec=480
TimeoutStopSec=180

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal

# Optional: prevent runaway resource use (uncomment if needed later)
# MemoryHigh=10G
# MemoryMax=12G
# CPUQuota=350%

[Install]
WantedBy=multi-user.target
