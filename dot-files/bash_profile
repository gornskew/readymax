function grokly
{
    # Grok Build CLI (xAI). MCP servers are written into ~/.grok/config.toml
    # at stack startup by merge-mcp-configs.el (same [mcp_servers.*] tables
    # as Codex, without nested tool-approval sections).
    local grok_bin="${HOME}/.local/bin/grok"
    if [ ! -x "$grok_bin" ]; then
        grok_bin="${HOME}/.grok/bin/grok"
    fi
    if [ ! -x "$grok_bin" ]; then
        echo "Error: grok CLI not found (installs in full/aituis image variants)."
        echo "Rebuild with: docker/build  (or pull a newer *-full / *-aituis image)"
        return 1
    fi

    if [ ! -f "${HOME}/.grok/config.toml" ] || ! grep -q 'BEGIN SKEWED-EMACS MCP' "${HOME}/.grok/config.toml" 2>/dev/null; then
        echo "Warning: Grok MCP block not found in ~/.grok/config.toml"
        echo "Run './compose-dev up' so merge-mcp-configs.el can install MCP servers."
    fi

    echo "Starting Grok CLI with MCP integration..."
    cd /projects && "$grok_bin" "$@"
}


# Windows Claude Desktop MCP config helper
function export-windows-mcp-config
{
    local output_path="${1:-/projects/merged-mcp-windows.json}"

    if [ ! -f "/tmp/merged-mcp-windows.json" ]; then
        echo "Error: Merged Windows MCP config not found."
        echo "Make sure the container stack has been started with './compose-dev up'"
        return 1
    fi

    echo "Copying merged Windows MCP config to: $output_path"
    cp /tmp/merged-mcp-windows.json "$output_path"

    echo ""
    echo "Windows Claude Desktop Setup Instructions:"
    echo "1. Copy this file from your Linux/WSL environment to Windows:"
    echo "   - File location: $output_path"
    echo "2. On Windows, copy to: %APPDATA%\\Claude\\claude_desktop_config.json"
    echo "   (typically: C:\\Users\\<username>\\AppData\\Roaming\\Claude\\claude_desktop_config.json)"
    echo "3. Restart Claude Desktop to load the new configuration"
    echo ""
    echo "From Windows PowerShell, you can use:"
    echo "   wsl.exe cat $output_path > \$env:APPDATA\\Claude\\claude_desktop_config.json"
    echo ""
}




# file naming utilities.


function latest_grep {
    # Move into the logs directory
    cd ~/logs
    # Grep the logs for a pattern and extract file names, then sort them by modification time
    grep "$1" *.log | cut -d':' -f1 | xargs ls -t | head -n 1
}


kill_port() {
    if [[ -z "$1" ]]; then
        echo "Usage: kill_port <port_number>"
        return 1
    fi

    local port=$1
    echo "Attempting to kill process on port $port..."
    sudo fuser -k -n tcp $port
}


codepaste() {
    find . -type f \
        -not -path '*/.git/*' \
        -not -path '*/node_modules/*' \
        -not -path '*/bin/*' \
        -not -path '*/build/*' \
        -not -path '*/dist/*' \
        -not -path '*/target/*' \
        -not -path '*/__pycache__/*' \
        -not -path '*/venv/*' \
        -not -path '*/.venv/*' \
        -not -name "*.log" \
        -exec grep -lI '' {} + 2>/dev/null \
        | xargs -I {} sh -c '
            echo "--- {} ---";
            cat "{}";
            echo -e "\n\n"
        '
}


# Check if running in Bash
if [ -n "$BASH_VERSION" ]; then
    # Only proceed if .bash_profile hasn’t been loaded yet
    if [ -z "$DOT_BASH_PROFILE_LOADED" ]; then
        # Mark .bash_profile as loaded
        export DOT_BASH_PROFILE_LOADED=1

        # Source .profile if it exists and hasn’t been loaded
        if [ -f "$HOME/.profile" ] && [ -z "$DOT_PROFILE_LOADED" ]; then
            . "$HOME/.profile"
            export DOT_PROFILE_LOADED=1
        fi

        # Source .bashrc if it exists and hasn’t been loaded
        if [ -f "$HOME/.bashrc" ] && [ -z "$DOT_BASHRC_LOADED" ]; then
            . "$HOME/.bashrc"
            export DOT_BASHRC_LOADED=1
        fi

        # .bashrc's `dircolors -b` restores the stock (dim blue di=01;34)
        # LS_COLORS, and it runs AFTER the login-time `theme` call above --
        # clobbering the theme's directory/link colors, so the first
        # `ls` after attach is low-contrast until you re-run `theme`.
        # Re-apply the theme's dircolors last, so the chosen theme wins
        # on first attach.
        if [[ $- == *i* ]] && type set_dircolors_theme >/dev/null 2>&1; then
            set_dircolors_theme "${THEME:-dark}"
        fi
    fi
fi



if [ -f "$HOME/.local/bin/env" ]; then 
. "$HOME/.local/bin/env"
fi

if [ -f "$HOME/.private-config/dot-files/bash_profile" ]; then 
 . "$HOME/.private-config/dot-files/bash_profile"
fi




# Skewed Emacs shell helpers
## Basilisk-family shell helpers: the canon calls (rmax/grmax in
## shell-functions.sh) and any register fork's renamed calls
## (e.g. rmacs/grmacs in shell-functions-rmacs.sh), each written
## per-host by `basilisk install-shell-functions` or a fork's
## equivalent.  Sourced by glob so this file never needs a
## host-specific line appended to it.
for _skewed_sf in "$HOME"/.config/skewed-emacs/shell-functions*.sh; do
    [ -r "$_skewed_sf" ] && . "$_skewed_sf"
done
unset _skewed_sf





export PATH="$HOME/.local/bin:$PATH"
