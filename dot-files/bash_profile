# document what this next section does:
# This script sets up the environment for a Bash shell, including PATH, editor settings,
# terminal settings, and theme-switching functions. It also includes a welcome message and
# a function to start a Gendl instance with a Swank server. The script is designed to be
# sourced in an interactive shell, ensuring that it does not exit prematurely and that it
# only runs once per session.
# Check if .bash_profile has already been loaded


# Set PATH early and cleanly
export PATH="/snap/bin:$PATH"

export ALTERNATE_EDITOR=""
export EDITOR="emacsclient -t"
export VISUAL="emacsclient -c -a emacs"



# Terminal settings
export TERM="xterm-256color"
export COLORTERM="truecolor"
alias ssh='TERM=xterm-256color COLORTERM=truecolor ssh'



# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color


# Theme-switching functions (unchanged)
set_prompt_theme() {
    local theme="${1:-dark}"
    case "$theme" in
        dark)
            PS1='${debian_chroot:+($debian_chroot)}\[\033[38;2;0;255;128m\]\u@\h\[\033[0m\]:\[\033[38;2;0;191;255m\]\w\[\033[0m\]\$ '
            ;;
        light)
            PS1='${debian_chroot:+($debian_chroot)}\[\033[38;2;139;0;0m\]\u@\h\[\033[0m\]:\[\033[38;2;0;0;139m\]\w\[\033[0m\]\$ '
            ;;
        solarized)
            PS1='${debian_chroot:+($debian_chroot)}\[\033[38;2;181;137;0m\]\u@\h\[\033[0m\]:\[\033[38;2;38;139;210m\]\w\[\033[0m\]\$ '
            ;;
        custom)
            PS1='${debian_chroot:+($debian_chroot)}\[\033[38;2;255;165;0m\]\u@\h\[\033[0m\]:\[\033[38;2;147;112;219m\]\w\[\033[0m\]\$ '
            ;;
        *)
            echo "Unknown theme: $theme"
            return 1
            ;;
    esac
    export PS1
}

set_dircolors_theme() {
    local theme="${1:-dark}"
    if [ -x /usr/bin/dircolors ]; then
        local colors
        case "$theme" in
            dark)
                colors="DIR 38;2;0;191;255
FILE 38;2;255;255;255
EXEC 38;2;0;255;128
LINK 38;2;255;215;0"
                ;;
            light)
                colors="DIR 38;2;0;0;139
FILE 38;2;0;0;0
EXEC 38;2;139;0;0
LINK 38;2;0;139;139"
                ;;
            solarized)
                colors="DIR 38;2;38;139;210
FILE 38;2;147;161;161
EXEC 38;2;181;137;0
LINK 38;2;203;75;22"
                ;;
            custom)
                colors="DIR 38;2;147;112;219
FILE 38;2;245;245;220
EXEC 38;2;255;165;0
LINK 38;2;255;215;0"
                ;;
            *)
                colors=""
                ;;
        esac
        if [ -n "$colors" ]; then
            eval "$(echo "$colors" | dircolors -b -)"
        else
            eval "$(dircolors -b)"
        fi
    fi
}

theme() {
    local theme="${1:-dark}"
    local quiet=${2:-0}
    if [ "$theme" = "auto" ]; then
        rm -f "$HOME/.config/skewed-theme"
        unset THEME
        SKEWED_THEME_NO_STICKY=1 theme "$(detect_theme)" "$quiet"
        return
    fi
    set_prompt_theme "$theme" || return 1
    set_dircolors_theme "$theme"
    export THEME="$theme"
    if [ "$quiet" -eq 0 ] && [ -z "$SKEWED_THEME_NO_STICKY" ]; then
        mkdir -p "$HOME/.config"
        echo "$theme" > "$HOME/.config/skewed-theme"
    fi
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
    case "$TERM" in
        xterm*|rxvt*)
            PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h: \w\a\]$PS1"
            ;;
    esac
    if [ "$quiet" -eq 0 ]; then
        echo "Switched to $theme theme. Use theme_help for more options."
    fi
}

theme_help() {
    echo "Terminal theme switching:"
    echo "  theme dark     - Switch to dark theme"
    echo "  theme light    - Switch to light theme"
    echo "  theme solarized - Switch to solarized theme"
    echo "  theme custom   - Switch to custom theme"
    echo "  theme auto     - Follow Windows light/dark mode (clears sticky choice)"
    echo ""
    echo "Manual picks stick across new tabs via ~/.config/skewed-theme;"
    echo "'theme auto' deletes that file and follows the OS setting."
}

# Resolve which theme to apply at login: explicit $THEME wins, then the
# sticky choice saved by an interactive theme command, then the Windows
# app light/dark mode (via reg.exe when running under WSL), else dark.
detect_theme() {
    if [ -n "$THEME" ]; then echo "$THEME"; return; fi
    if [ -r "$HOME/.config/skewed-theme" ]; then cat "$HOME/.config/skewed-theme"; return; fi
    local reg=/mnt/c/Windows/System32/reg.exe
    if [ -x "$reg" ]; then
        case "$("$reg" query 'HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize' /v AppsUseLightTheme 2>/dev/null)" in
            *0x1*) echo light; return ;;
            *0x0*) echo dark; return ;;
        esac
    fi
    echo dark
}

# Nested interactive shells re-source .bashrc (whose dircolors call
# clobbers themed LS_COLORS) without re-reading this file; exporting the
# functions lets a .bashrc tail hook re-apply the theme there.
export -f set_prompt_theme set_dircolors_theme theme theme_help detect_theme

# Interactive shell setup add conditional for setting theme and
# printing Welcome message - welcome message should be printed only
# once and a flag set so it won't be printed a second time e.g. after
# an exec.  If not interactive shell, do not exit, simply continue. 


if [[ $- == *i* && -z "$DOT_BASH_PROFILE_WELCOME" ]]; then
    # Apply default theme quietly
    theme "$(detect_theme)" 1
    # Show welcome message
    echo ""
    echo "Welcome to the 🦖 Skewed Emacs 🦖  Bash Setup"
    echo ""
    printf "%b\n" "\`e\` ${BLUE}for a terminal emacsclient, or${NC}"
    printf "%b\n\n" "\`egui\` ${BLUE}for a graphical one.${NC}"
    echo ""
    echo "Terminal colors: 'theme dark|light|solarized|custom|auto'"
    echo ""
    echo "Try 'claudly', 'geminly', 'codexly', 'grokly' to launch those agents."
    echo ""
    echo "Windows users: Run 'export-windows-mcp-config' to get Claude Desktop config."
    echo ""
    export DOT_BASH_PROFILE_WELCOME=1
fi


# convenience functions

function e() {
    file=${1:-""};
    emacsclient -t ${file}
}

function egui() {
    file=${1:-""};
    emacsclient -c ${file} &
}


#
# Local AI CLI functions - tools run directly in skewed-emacs container
# (Node.js and AI tools are now installed locally, no longer via SSH to lisply-mcp)
#

function claudly
{
    # Update Claude Code to latest version
    echo "Checking for Claude Code updates..."
    (cd ~/.claude/local && npm update @anthropic-ai/claude-code) >/dev/null 2>&1

    # Run Claude with the merged config (prepared at container startup)
    echo "Starting Claude Code with MCP integration..."
    cd /projects && ~/.local/bin/claude --mcp-config /tmp/merged-mcp-config.json
}




function geminly
{
    # Update Gemini CLI to latest version
    echo "Checking for Gemini CLI updates..."
    (cd ~/.gemini/local && npm update @google/gemini-cli) >/dev/null 2>&1

    # Copy pre-merged MCP config to Gemini settings location
    echo "Preparing MCP configuration..."
    mkdir -p ~/.gemini
    cp /tmp/merged-mcp-config.json ~/.gemini/settings.json

    # Run Gemini with the merged config
    echo "Starting Gemini CLI with MCP integration..."
    cd /projects && ~/.local/bin/gemini
}




