# ==============================================================================
# ONE list serving as .gitignore AND .dockerignore.
#
# .dockerignore is a tracked SYMLINK to this file (git mode 120000), not
# a copy -- so the two can never drift, and there is nothing to keep in
# sync when you edit here.  Do not "fix" it into a real file.
#
# That is why a few rules below look pointless to git: `.git/' can never
# do anything in a .gitignore (git does not track its own directory) but
# it is one of the most important lines in a .dockerignore.  Judge every
# rule here against BOTH jobs before removing it.
#
# The counterpart in basilisk is NOT mirrored: that repo has no image and
# no .dockerignore, so its copy of this header was removed 2026-08-16.
# ==============================================================================

# ==============================================================================
# Emacs temporary/backup files
# ==============================================================================
*~
.#*
**/#*#
*.elc

# ==============================================================================
# Log files
# ==============================================================================
*.log
*.log*

# ==============================================================================
# Emacs user directories (regenerated, user-specific)
# ==============================================================================
dot-files/emacs.d/auto-save-list/
dot-files/emacs.d/eln-cache/
dot-files/emacs.d/elpa/
dot-files/emacs.d/elpa-archives/
dot-files/emacs.d/ellama-sessions/
dot-files/emacs.d/eshell/
dot-files/emacs.d/melpa/
dot-files/emacs.d/org-persist/
dot-files/emacs.d/quelpa/
dot-files/emacs.d/request/
dot-files/emacs.d/semanticdb/
dot-files/emacs.d/sideloaded/claude-code/
dot-files/emacs.d/straight/
dot-files/emacs.d/.straight/
dot-files/emacs.d/tramp
dot-files/emacs.d/transient/
dot-files/emacs.d/url/
dot-files/emacs.d/var/
dot-files/emacs.d/vterm/
dot-files/emacs.d/workspace/

# Emacs user state files
dot-files/emacs.d/.chatgpt-shell.el
dot-files/emacs.d/.dap-breakpoints
dot-files/emacs.d/.lsp-session*
dot-files/emacs.d/abbrev_defs
dot-files/emacs.d/custom.el
dot-files/emacs.d/ielm-history.eld
dot-files/emacs.d/network-security.data
dot-files/emacs.d/org-clock-save.el
dot-files/emacs.d/places
dot-files/emacs.d/projectile-bookmarks.eld
dot-files/emacs.d/projectile-frecency.eld
dot-files/emacs.d/recentf

# ==============================================================================
# Auth & secrets (never include in build)
# ==============================================================================
.authinfo
.authinfo.gpg
.env
.tokens/
*token*

# ==============================================================================
# Local user configuration
# ==============================================================================
.claude/
.emacs-local
.emacs-local-early
custom.el*
private-mcp-config.json
overlays/local.sexp

# ==============================================================================
# Gone with the Basilisk split (2026-08-15), removed here 2026-08-16
# ==============================================================================
# Eleven rules used to live at this point, covering generated compose
# files (genworks-gdl*.yml, betatest*.yml, enterprise*.yml,
# *-stack-compose.yml, *-overlay.yml, *-dev-overlay.yml), the mcp/
# directory (mcp/*mcp* plus its two negations and two named files), and
# dot-files/emacs.d/etc/*-services-generated.el.
#
# None of those paths exist in this repo any more.  skewed-emacs is the
# Captain -- an Emacs config and the image carrying it -- and there is
# deliberately no supported way to start anything from this clone.  The
# stack, its SSoT and its generated output all live in basilisk, whose
# .gitignore carries the live versions of these rules.
#
# Generated services elisp goes in <repo>/generated/, never in
# dot-files/; dot-files/ is Emacs configuration only.

# ==============================================================================
# Build artifacts & caches
# ==============================================================================
.cache/
# For the .dockerignore half of this file's job -- see the header.  It is
# inert as a git rule and that is fine; it is not noise, it is the line
# that keeps the whole history out of the build context.
.git/
.idea/
.npm/
.vscode/
__pycache__/
node_modules/
temp/
tmp/

# ==============================================================================
# History files
# ==============================================================================
.bash_history
history.*
# Also removed 2026-08-16: a second `.#*' (already covered at the top of
# the file) and *cyclops*.yml / *cyclops*.el, which matched nothing here
# -- cyclops has its own repo and its config is generated into basilisk.
