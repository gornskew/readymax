# =============================================================================
# SERVICE MANAGEMENT
# =============================================================================
start_services() {
    _ss_services="$*"
    init_env
    ensure_env

    # Ensure AI TUI auth placeholder files exist on host.
    # (Docker bind-mounts create directories for missing files, breaking TUIs.)
    for _auth_file in \
        "${HOME}/.claude/.credentials.json" \
        "${HOME}/.gemini/google_accounts.json" \
        "${HOME}/.gemini/oauth_creds.json" \
        "${HOME}/.codex/auth.json" \
        "${HOME}/.grok/auth.json"
    do
        if [ ! -f "$_auth_file" ]; then
            mkdir -p "$(dirname "$_auth_file")"
            touch "$_auth_file"
            log_info "Created placeholder: $_auth_file"
        fi
    done

    pull_images

    log_info "Starting services: ${_ss_services:-all}"
    # shellcheck disable=SC2086  (word-split intentional: service names)
    run_compose up -d $_ss_services

    # Started != validated: actively probe every healthchecked service
    # (kill + recreate hung-on-start containers, e.g. the CCL ASLR
    # wedge) BEFORE doing anything that depends on a running daemon.
    _ss_rc=0
    validate_services || _ss_rc=1

    # crew identities: per-container maintenance pass over the
    # just-validated fleet, same slot merge_mcp_configs already
    # occupies below -- order between the two doesn't matter, this
    # one just needs live containers
    mint_crew_identities

    # MCP merge runs after validation on purpose: a kill+recreate of
    # skewed-emacs would discard files copied into the container, and
    # a validated skewed-emacs means the daemon is provably ready --
    # no blind "waiting for emacs daemon" retry loop needed.
    merge_mcp_configs

    refresh_emacs_runtime_config

    return "$_ss_rc"
}

stop_services() {
    log_info "Stopping all services"
    run_compose down
}

restart_services() {
    log_info "Restarting services: ${*:-all}"
    run_compose restart "$@"
    validate_services
    # a plain restart keeps the container's filesystem, so this is a
    # no-op for every service today (see the CREW IDENTITY MINTING
    # header comment) -- wired in now so the hook point already exists
    # once recreate-vs-restart semantics get worked out
    mint_crew_identities
}

# =============================================================================
# CREW IDENTITY MINTING (the Basilisk ship-and-crew conceit, framework-level)
#
# Mints a per-container identity -- NAME (random, species-flavored),
# SPECIES, ROLE -- and writes it into /tmp/skewed-crew-identity inside
# each running container, once.  Species/role are inferred from the
# compose SERVICE NAME, the same name services.sexp already assigns as
# container_name/hostname (generate-configs.el) -- no schema change,
# every existing overlay (sally-stack, shelly-stack, ...) participates
# automatically, and any container this script has never heard of
# before still gets a generic crew/unknown identity.
#
# IDEMPOTENT BY DESIGN: skips any container whose identity file already
# exists.  A plain docker restart (same filesystem) therefore keeps
# its name; only a genuinely fresh/recreated container (new writable
# layer, no file) mints one.  Whether that is the full desired restart
# semantics is an open question (Dave, 2026-08-14) -- this is the
# conservative default until that gets worked through.
#
# Consumers: eyes-only-metrics.lisp's MY-IDENTITY and (for the Captain)
# EMACS-SAMPLE-ELISP both read this file in preference to minting their
# own name -- see apps/eyes-only source/metrics.lisp.
# =============================================================================

# Species = the container's IMAGE, not its compose service name or
# container name (Dave, 2026-08-14): a service could be renamed in an
# overlay without changing what it actually runs, and species should
# track the latter.  Matched against the running container's own
# Config.Image (docker inspect), so this needs nothing from
# services.sexp and works for a service this script has never named.
# The genworks/gdl vs gornskew/gendl ORG NAMESPACE is the real signal
# behind gendl vs genworks-gdl -- community shop vs commissioned fleet
# engineering IS the licensing-tier distinction (Cluster commercial-
# tiering thread, org).  (Said "Starfleet" until 2026-08-15; the ship
# skin was walked back off recognizable Star Trek dress precisely to
# reduce cease-and-desist exposure -- see eyes-only/THEMES.md -- and
# leaving the word in a shipped open-source file gave that back for
# nothing.  The fleet is ours; it does not need anyone else's navy.)
_crew_species_from_image() {
    case "$1" in
        */skewed-emacs:*|skewed-emacs:*) echo "skewed-emacs" ;;
        */cyclops:*|cyclops:*)           echo "cyclops" ;;
        genworks/gdl:*)                  echo "genworks-gdl" ;;
        */gendl:*|gendl:*)               echo "gendl" ;;
        */autoheal:*|autoheal:*)         echo "autohealer" ;;
        *)                                echo "unknown" ;;
    esac
}

# Role follows from species alone -- every species in the fleet maps
# to exactly one role today (one Captain-shaped thing, one Pilot-
# shaped thing, ...).  Unknown species still participate (generic
# crew), so nothing needs to opt in.
_crew_role_for_species() {
    case "$1" in
        skewed-emacs)        echo "captain" ;;
        cyclops)              echo "pilot" ;;
        gendl|genworks-gdl)   echo "engineer" ;;
        autohealer)           echo "doctor" ;;
        *)                    echo "crew" ;;
    esac
}

# Name-pool syllables per species -- kept in sync BY HAND with
# eyes-only-metrics.lisp's *CREW-NAME-POOLS* (that Lisp copy is now the
# fallback path only; this shell copy is authoritative whenever
# compose-dev is what started the stack).
_crew_onsets_for() {
    case $1 in
        skewed-emacs) echo 'Bl Gr Thr Kro Zar Vex Mog Drel' ;;
        cyclops)      echo 'Bl Zh Vek Skr Yor Tsa Kli Dro' ;;
        gendl)        echo 'Ka Lis Par Quo Sem Tel Nym Ori' ;;
        genworks-gdl) echo 'Ad Bex Cor Dal Enn Fir Gal Hux' ;;
        autohealer)   echo 'Om Sal Vel Lum Mir Ana Eir Thea' ;;
        *)            echo 'X Yz Qm' ;;
    esac
}
_crew_finals_for() {
    case $1 in
        skewed-emacs) echo 'org arn und ath esh ork ilk uz' ;;
        cyclops)      echo 'ej ix osk arr unn eth yx oa' ;;
        gendl)        echo 'da per lon ta mir vex is und' ;;
        genworks-gdl) echo 'mand ton dry well berg worth field ston' ;;
        autohealer)   echo 'a une is oon ara elle ios em' ;;
        *)            echo 'ar il ot' ;;
    esac
}

# Random 1-based pick from a space-separated word list ($1).  No bash
# arrays/$RANDOM (dash has neither) -- /dev/urandom via od, same
# portability posture as the rest of this script.
_crew_pick() {
    set -- $1
    _cp_n=$#
    _cp_r=$(od -An -N2 -tu2 /dev/urandom | tr -d ' ')
    _cp_i=$(( (_cp_r % _cp_n) + 1 ))
    eval "echo \${$_cp_i}"
}

# One species-flavored name, unique against every name minted so far
# THIS RUN (_crew_minted_names).  20 collisions -> numeral-disambiguated
# (mirrors eyes-only-metrics.lisp's MINT-CREW-NAME).
_crew_unique_name() {
    _cun_species=$1
    _cun_tries=0
    while :; do
        _cun_name="$(_crew_pick "$(_crew_onsets_for $_cun_species)")$(_crew_pick "$(_crew_finals_for $_cun_species)")"
        case " ${_crew_minted_names} " in
            *" ${_cun_name} "*)
                _cun_tries=$((_cun_tries + 1))
                [ $_cun_tries -ge 20 ] && {
                    _cun_name="${_cun_name}-$(od -An -N1 -tu1 /dev/urandom | tr -d ' ')"
                    break
                }
                continue
                ;;
            *) break ;;
        esac
    done
    # set a result var, NOT echo+$(...) -- a command-substitution call
    # would run this function in a SUBSHELL, silently discarding its
    # write to _crew_minted_names (caught empirically 2026-08-14: two
    # calls minted the same name back to back).  Callers read
    # $_crew_unique_name_result after calling this directly.
    _crew_minted_names="${_crew_minted_names:+$_crew_minted_names }${_cun_name}"
    _crew_unique_name_result="$_cun_name"
}

mint_crew_identities() {
    _ci_ids="$(run_compose ps -q 2>/dev/null)"
    [ -n "$_ci_ids" ] || return 0

    _crew_minted_names=""
    for _ci_id in $_ci_ids; do
        _ci_name="$(docker inspect --format "{{.Name}}" "$_ci_id" 2>/dev/null)" || continue
        _ci_name="${_ci_name#/}"

        if docker exec "$_ci_name" test -f /tmp/skewed-crew-identity 2>/dev/null; then
            continue   # already identified -- filesystem survived, keep the name
        fi

_ci_image="$(docker inspect --format \
            "{{.Config.Image}}" \
            "$_ci_id" 2>/dev/null)"

        _ci_species="$(_crew_species_from_image "$_ci_image")"
        _ci_role="$(_crew_role_for_species "$_ci_species")"
        _crew_unique_name "$_ci_species"
        _ci_mint_name="$_crew_unique_name_result"

        if docker exec "$_ci_name" sh -c \
            "printf 'NAME=%s\nSPECIES=%s\nROLE=%s\n' '$_ci_mint_name' '$_ci_species' '$_ci_role' > /tmp/skewed-crew-identity" \
            2>/dev/null
        then
            log_success "  ${_ci_name}: crew identity minted -- ${_ci_mint_name} (${_ci_role}, ${_ci_species})"
        else
            log_warning "  ${_ci_name}: could not write crew identity (no shell/writable rootfs?)"
        fi
    done
}


# =============================================================================
# MCP CONFIG MERGE
#
# Writes merged MCP config files inside the skewed-emacs container and
# updates /home/emacs-user/.codex/config.toml and ~/.grok/config.toml.
# Runs AFTER validate_services: overlay copies into a container that
# validation might still kill+recreate would be lost, and a validated
# skewed-emacs (its lisply-ping healthcheck is served by the emacs
# daemon itself) proves the daemon is ready -- the merge runs exactly
# once, event-driven, replacing the old 5x2s blind retry loop.
# =============================================================================
merge_mcp_configs() {
    log_info "Preparing MCP configurations (JSON + TOML)..."

    case " ${VALIDATED_OK:-} " in
        *" skewed-emacs "*) ;;
        *)
            # skewed-emacs was not validated this run (single-service up,
            # failed validation, or already running from before): probe the
            # daemon once directly instead of looping blind.
            if ! run_compose exec -T skewed-emacs emacsclient --eval t \
                > /dev/null 2>&1
            then
                log_warning "skewed-emacs daemon not available; skipping MCP config merge"
                return 1
            fi
            ;;
    esac

    # Lite-variant images do not ship ~/.codex and ~/.grok, so docker
    # creates those file-mount parent dirs ROOT-OWNED at container
    # create time (a recreate reintroduces them; host-side chown cannot
    # reach container-fs dirs).  The merge writes config.toml into both,
    # so repair ownership first; harmless no-op on full images.
    run_compose exec -T -u root skewed-emacs sh -c \
        "chown -R emacs-user /home/emacs-user/.codex /home/emacs-user/.grok" \
        > /dev/null 2>&1 || true

    # Step 1: Copy overlay MCP config files into container
    for _overlay in \
        "${SCRIPT_DIR}/mcp/"*-mcp-windows.json \
        "${SCRIPT_DIR}/mcp/"*-mcp-container.json \
        "${SCRIPT_DIR}/mcp/"*-mcp.toml
    do
        [ -f "$_overlay" ] || continue
        log_info "Copying overlay: $(basename "$_overlay")"
        run_compose cp "$_overlay" \
            skewed-emacs:/home/emacs-user/skewed-emacs/mcp/ 2>/dev/null || true
    done

    # Step 1b: Copy overlay services-generated Emacs files, PLUS
    # services-discovery.el -- the discovery/merge logic and the
    # generated files are a matched pair (sparse overlay entries rely
    # on key-wise merging in discovery).  Syncing one without the
    # other skews them when the running image predates a discovery
    # change (bit us 2026-08-09: gendl-ccl vanished from the dashboard
    # Swank list on a stale image + fresh sparse overlay).
    for _overlay in "${SCRIPT_DIR}/dot-files/emacs.d/etc/"*-services-generated.el \
                    "${SCRIPT_DIR}/dot-files/emacs.d/etc/services-discovery.el"; do
        [ -f "$_overlay" ] || continue
        log_info "Copying overlay: $(basename "$_overlay")"
        run_compose cp "$_overlay" \
            skewed-emacs:/home/emacs-user/skewed-emacs/dot-files/emacs.d/etc/ 2>/dev/null || true
    done

    # Step 2: Merge inside container -- one shot; the daemon is ready.
    if run_compose exec -T skewed-emacs emacsclient --eval \
        "(progn (setenv \"SKEWED_CLONE_PATH\" \"${SCRIPT_DIR}\")
                (load-file \"/home/emacs-user/skewed-emacs/mcp/merge-mcp-configs.el\")
                (skewed-merge-all-mcp-configs \"/home/emacs-user/skewed-emacs/mcp\"))" \
        > /dev/null 2>&1
    then
        log_success "MCP configurations merged for container CLI, Windows, Codex, and Grok"

        # Copy the platform-appropriate Claude Desktop config back to the
        # host clone (regression fix: the pre-POSIX compose-dev did this).
        # WSL hosts get the wsl-wrapped config; Linux/macOS get the native one.
        if grep -qi microsoft /proc/version 2>/dev/null; then
            _cdc_src="/tmp/merged-mcp-windows.json"
        else
            _cdc_src="/tmp/merged-mcp-host.json"
        fi
        if run_compose cp "skewed-emacs:${_cdc_src}" \
            "${SCRIPT_DIR}/mcp/claude_desktop_config.json" 2>/dev/null; then
            log_success "Claude Desktop config ready: mcp/claude_desktop_config.json (see docs/CLAUDE_DESKTOP.md)"
        else
            log_warning "Could not copy Claude Desktop config from container"
            log_warning "(an older skewed-emacs image may not generate ${_cdc_src};"
            log_warning " try './compose-dev up --pull' to fetch the latest image)"
        fi
    else
        log_warning "MCP configuration merge failed (daemon answered but merge errored)"
        log_warning "Retry with: ./compose-dev up"
        return 1
    fi
}

# =============================================================================
# STARTUP VALIDATION ("container started" != "service validated")
#
# CCL occasionally loses its ASLR dice roll at startup ("exception 11" /
# "bad frame in rt_sigreturn", upstream Clozure/ccl#85): the process
# does not exit -- it hangs in the CCL kernel debugger -- so
# `restart: unless-stopped` never fires and the container sits there
# "running" while never becoming healthy.  The generated healthchecks
# have long intervals (gendl-ccl: 72s x 3 retries), so docker/autoheal
# take minutes to notice; a gendl container that is going to come up
# does so well within ~30s.  So compose-dev owns start-time validation
# itself (autoheal keeps steady-state duty):
#
#   - Each healthchecked container is actively probed every few seconds
#     by running its own compose-declared healthcheck test via docker
#     exec -- no per-service knowledge is hardcoded here, and docker's
#     slow health interval stops mattering at startup.
#   - A container that exhausts its budget unvalidated is KILLED
#     (SIGKILL: the wedged CCL debugger is SIGTERM-immune) and
#     RECREATED -- a fresh exec re-rolls the ASLR dice; a hung-at-start
#     container holds no state worth preserving.
#   - Retries are capped; then we fail LOUDLY with a nonzero exit so a
#     systemd oneshot unit shows the failure.
#
# Tunables (env):
#   HEALTH_WAIT_SECS        per-service validation budget (default 30)
#   HEALTH_BUDGET_<name>    per-service override, name sanitized to
#                           [A-Za-z0-9_], e.g. HEALTH_BUDGET_gendl_ccl=45
#   HEALTH_MAX_RESTARTS     kill+recreate budget per service (default 2)
#   HEALTH_POLL_SECS        probe cadence (default 2)
#   VALIDATE_PROBE_TIMEOUT  in-container timeout per probe (default 5)
#
# Results are exported in VALIDATED_OK / VALIDATED_FAILED (space-
# separated container names) for later phases (e.g. the MCP merge).
# =============================================================================
_vs_sanitize() {
    printf '%s' "$1" | tr -c 'a-zA-Z0-9' '_'
}

# Run one active probe of a container: its own declared healthcheck
# test via docker exec, wrapped in an in-container timeout (probe
# lesson from the rt_sigreturn brief: put the timeout INSIDE the
# container).  Falls back to docker's health status when the container
# lacks timeout(1) or the test could not be extracted.
_vs_probe() {
    _vp_san="$(_vs_sanitize "$1")"
    eval "_vp_cmd=\${_vs_probe_cmd_${_vp_san}:-}"
    if [ -n "$_vp_cmd" ]; then
        docker exec "$1" sh -c \
            "timeout -s KILL ${VALIDATE_PROBE_TIMEOUT:-5} $_vp_cmd" \
            > /dev/null 2>&1
        _vp_rc=$?
        [ "$_vp_rc" -eq 0 ] && return 0
        if [ "$_vp_rc" -eq 127 ]; then
            # timeout(1) missing in this container: retry bare.
            docker exec "$1" sh -c "$_vp_cmd" > /dev/null 2>&1 && return 0
        fi
    fi
    [ "$(docker inspect --format \
        '{{if .State.Health}}{{.State.Health.Status}}{{else}}unknown{{end}}' \
        "$1" 2>/dev/null)" = "healthy" ]
}

# Kill + recreate one container.  SIGKILL, not SIGTERM: a wedged CCL
# sits in its kernel debugger, which ignores SIGTERM.  Recreate (not
# restart) also re-resolves mount sources and image config.
_vs_recreate() {
    docker kill "$1" > /dev/null 2>&1
    if ! run_compose up -d --force-recreate --no-deps "$2" > /dev/null 2>&1; then
        log_error "  ${1}: recreate failed (docker compose up --force-recreate ${2})"
    fi
}

validate_services() {
    _vs_budget_default="${HEALTH_WAIT_SECS:-30}"
    _vs_retries_max="${HEALTH_MAX_RESTARTS:-2}"
    _vs_poll="${HEALTH_POLL_SECS:-2}"
    VALIDATED_OK=""
    VALIDATED_FAILED=""

    _vs_ids="$(run_compose ps -q 2>/dev/null)"
    [ -n "$_vs_ids" ] || { log_warning "No running containers to validate"; return 0; }

    # Build the watch list: containers that declare a usable healthcheck.
    _vs_watched=""
    for _vs_id in $_vs_ids; do
        _vs_name="$(docker inspect --format '{{.Name}}' "$_vs_id" 2>/dev/null)" || continue
        _vs_name="${_vs_name#/}"
        _vs_test="$(docker inspect --format \
            '{{if .Config.Healthcheck}}{{join .Config.Healthcheck.Test " "}}{{end}}' \
            "$_vs_id" 2>/dev/null)"
        case "$_vs_test" in
            ""|NONE|"NONE "*)
                log_info "  ${_vs_name}: started (no healthcheck; not validated)"
                continue
                ;;
        esac
        _vs_svc="$(docker inspect --format \
            '{{index .Config.Labels "com.docker.compose.service"}}' \
            "$_vs_id" 2>/dev/null)"
        [ -n "$_vs_svc" ] || _vs_svc="$_vs_name"
        _vs_san="$(_vs_sanitize "$_vs_name")"
        _vs_probe_tmp=""
        case "$_vs_test" in
            "CMD-SHELL "*) _vs_probe_tmp="${_vs_test#CMD-SHELL }" ;;
            "CMD "*)       _vs_probe_tmp="${_vs_test#CMD }" ;;
        esac
        eval "_vs_svc_${_vs_san}=\$_vs_svc"
        eval "_vs_probe_cmd_${_vs_san}=\$_vs_probe_tmp"
        eval "_vs_budget_${_vs_san}=\${HEALTH_BUDGET_${_vs_san}:-\$_vs_budget_default}"
        eval "_vs_state_${_vs_san}=pending"
        eval "_vs_elapsed_${_vs_san}=0"
        eval "_vs_tries_${_vs_san}=0"
        _vs_watched="${_vs_watched:+$_vs_watched }$_vs_name"
    done
    [ -n "$_vs_watched" ] || return 0

    log_info "Validating services (probe every ${_vs_poll}s; kill+recreate on hung start):"
    for _vs_name in $_vs_watched; do
        _vs_san="$(_vs_sanitize "$_vs_name")"
        eval "_vs_budget=\$_vs_budget_${_vs_san}"
        log_info "  ${_vs_name}: budget ${_vs_budget}s, retries ${_vs_retries_max}"
    done

    _vs_total=0
    while :; do
        _vs_pending=0
        for _vs_name in $_vs_watched; do
            _vs_san="$(_vs_sanitize "$_vs_name")"
            eval "_vs_state=\$_vs_state_${_vs_san}"
            [ "$_vs_state" = "pending" ] || continue

            if _vs_probe "$_vs_name"; then
                eval "_vs_tries=\$_vs_tries_${_vs_san}"
                if [ "$_vs_tries" -gt 0 ]; then
                    log_success "  ${_vs_name}: validated at ${_vs_total}s (after ${_vs_tries} kill+recreate)"
                else
                    log_success "  ${_vs_name}: validated at ${_vs_total}s"
                fi
                eval "_vs_state_${_vs_san}=ok"
                VALIDATED_OK="${VALIDATED_OK:+$VALIDATED_OK }$_vs_name"
                continue
            fi

            eval "_vs_elapsed=\$_vs_elapsed_${_vs_san}"
            eval "_vs_budget=\$_vs_budget_${_vs_san}"
            if [ "$_vs_elapsed" -ge "$_vs_budget" ]; then
                eval "_vs_tries=\$_vs_tries_${_vs_san}"
                if [ "$_vs_tries" -lt "$_vs_retries_max" ]; then
                    _vs_tries=$((_vs_tries + 1))
                    eval "_vs_tries_${_vs_san}=\$_vs_tries"
                    eval "_vs_svc=\$_vs_svc_${_vs_san}"
                    log_warning "  ${_vs_name}: not validated after ${_vs_budget}s (hung start?) -- kill + recreate (${_vs_tries}/${_vs_retries_max})"
                    _vs_recreate "$_vs_name" "$_vs_svc"
                    eval "_vs_elapsed_${_vs_san}=0"
                else
                    log_error "  ${_vs_name}: FAILED: still not validated after ${_vs_retries_max} kill+recreate retries"
                    eval "_vs_state_${_vs_san}=failed"
                    VALIDATED_FAILED="${VALIDATED_FAILED:+$VALIDATED_FAILED }$_vs_name"
                    continue
                fi
            else
                eval "_vs_elapsed_${_vs_san}=$((_vs_elapsed + _vs_poll))"
            fi
            _vs_pending=1
        done

        [ "$_vs_pending" -eq 0 ] && break
        sleep "$_vs_poll"
        _vs_total=$((_vs_total + _vs_poll))
    done

    if [ -z "$VALIDATED_FAILED" ]; then
        log_success "All services validated in ${_vs_total}s"
        return 0
    fi

    log_error "Validation FAILED for: ${VALIDATED_FAILED}"
    for _vs_name in $VALIDATED_FAILED; do
        log_error "--- last log lines from ${_vs_name}:"
        docker logs --tail 5 "$_vs_name" 2>&1 | sed 's/^/    /'
        case "$_vs_name" in
            gendl-*|genworks-*)
                log_error "    (CCL ASLR wedge? check host kernel log for 'bad frame in rt_sigreturn' -- upstream Clozure/ccl#85)"
                ;;
        esac
    done
    log_error "autoheal (if running) will keep retrying; investigate with: docker logs <name>"
    return 1
}

show_logs() {
    run_compose logs -f "$@"
}

show_status() {
    log_info "Service status:"
    run_compose ps
}

connect_emacs() {
    log_info "Connecting to Emacs via emacsclient"
    run_compose exec skewed-emacs emacsclient -t
}

pull_images() {
    if [ -n "${NO_PULL}" ]; then
        log_info "Skipping pull (NO_PULL set)"
        return
    fi

    if [ -n "${PULL_ALWAYS}" ]; then
        log_info "Pulling latest images (PULL_ALWAYS set)"
        run_compose pull
        return
    fi

    log_info "Pulling missing images only"

    _svc_img_pairs="$(
        run_compose config | awk '
            $1 == "services:" { in_services=1; next }
            in_services && match($0, /^[[:space:]]{2}[A-Za-z0-9_-]+:$/) {
                service=$1; sub(":", "", service); next
            }
            in_services && $1 == "image:" { print service, $2 }
        '
    )"

    _missing=""
    while IFS=" " read -r _svc _img; do
        [ -z "$_svc" ] || [ -z "$_img" ] && continue
        if docker image inspect "$_img" > /dev/null 2>&1; then
            log_info "Image present locally, skipping pull: $_svc ($_img)"
        else
            _missing="${_missing:+$_missing }$_svc"
        fi
    done << _PAIRS
$_svc_img_pairs
_PAIRS

    if [ -z "$_missing" ]; then
        log_success "All images present locally; skipping pull"
        return
    fi

    log_info "Pulling missing services: $_missing"
    # shellcheck disable=SC2086  (word-split intentional: service names)
    run_compose pull $_missing
}

clean_all() {
    log_warning "This will remove containers, networks, and unused images (including pulled ones)"
    printf "Are you sure? (y/N): "
    read -r REPLY
    case "$REPLY" in
        [Yy]*)
            log_info "Cleaning up..."
            run_compose down --rmi all --volumes --remove-orphans
            docker system prune -f
            log_success "Cleanup complete"
            ;;
        *)
            log_info "Cleanup cancelled"
            ;;
    esac
}

show_config() {
    log_info "Showing merged Docker Compose configuration"
    run_compose config
}

# =============================================================================
# SHELL FUNCTION INSTALLATION
#
# Detects the user's login shell and writes to the appropriate RC file(s).
# Supports bash (.bashrc), zsh (.zshrc), and generic POSIX (.profile).
# Also updates .bash_profile / .zprofile if they already exist (macOS).
# =============================================================================
install_shell_functions() {
    _isf_dir="${HOME}/.config/skewed-emacs"
    _isf_file="${_isf_dir}/shell-functions.sh"
    SHELL_HELPERS_CHANGED=false

    mkdir -p "${_isf_dir}"
    _isf_tmp="${_isf_dir}/shell-functions.sh.tmp.$$"

    # The snippet is pure POSIX sh -- works when sourced from any shell.
    cat > "${_isf_tmp}" << 'SNIPPET'
# Skewed Emacs shell helpers - auto-generated by compose-dev
# Works in bash, zsh, sh, or any POSIX-compatible shell.

# Both helpers are `docker exec` into the Cap'n's container.  A box may
# legitimately be running a hull with no Cap'n aboard -- a minimal roster,
# or a Cyclops/Eyes Only appliance, which is not a Basilisk at all -- and
# in that case docker's own "No such container: skewed-emacs" says nothing
# about what is actually going on.  Answer in the ship's own terms.
_skew_captain_aboard() {
    command -v docker >/dev/null 2>&1 || return 1
    [ "$(docker inspect -f '{{.State.Running}}' skewed-emacs 2>/dev/null)" = "true" ]
}

_skew_no_captain() {
    if ! command -v docker >/dev/null 2>&1; then
        printf '%s: docker not found on this host -- no way to reach the Cap'"'"'n.\n' "$1" >&2
    elif docker inspect skewed-emacs >/dev/null 2>&1; then
        printf '%s: the Cap'"'"'n is aboard but not on watch (container "skewed-emacs" is not running).\n' "$1" >&2
        printf '  Rouse him:  docker start skewed-emacs\n' >&2
    else
        printf '%s: no Cap'"'"'n aboard this ship (no "skewed-emacs" container).\n' "$1" >&2
        printf '  Bring one aboard:  ./basilisk up   (from your skewed-emacs checkout)\n' >&2
    fi
    return 1
}

eskew() {
    _skew_captain_aboard || { _skew_no_captain eskew; return 1; }
    docker exec -it --detach-keys "ctrl-^" skewed-emacs emacsclient -t "$@"
}

egskew() {
    _skew_captain_aboard || { _skew_no_captain egskew; return 1; }
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        docker exec -i -e DISPLAY="$DISPLAY" -e WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
            --detach-keys "ctrl-^" skewed-emacs emacsclient -c "$@" &
    else
        docker exec -it --detach-keys "ctrl-^" skewed-emacs emacsclient -t "$@"
    fi
}
SNIPPET

    if [ -f "${_isf_file}" ] && cmp -s "${_isf_tmp}" "${_isf_file}"; then
        rm -f "${_isf_tmp}"
        log_info "Shell functions already up to date in ${_isf_file}"
    else
        mv "${_isf_tmp}" "${_isf_file}"
        SHELL_HELPERS_CHANGED=true
        log_success "Shell functions written to ${_isf_file}"
    fi

    # Use '.' not 'source' -- POSIX portable
    _isf_source_line=". \"${_isf_file}\""

    # Primary RC based on login shell
    case "${SHELL##*/}" in
        zsh)  _isf_primary="${HOME}/.zshrc" ;;
        bash) _isf_primary="${HOME}/.bashrc" ;;
        ksh)  _isf_primary="${HOME}/.kshrc" ;;
        *)    _isf_primary="${HOME}/.profile" ;;
    esac

    # Belt and suspenders for fresh machines: login and non-login shells
    # read different RC files (.profile vs .bashrc), and a fresh account may
    # have SHELL=/bin/sh.  Ensure both .bashrc and .profile carry the source
    # line; the grep guard below keeps this idempotent.
    touch "$_isf_primary" "${HOME}/.bashrc" "${HOME}/.profile" 2>/dev/null || true

    _isf_wrote=false
    _isf_wrote_files=""
    # Write to primary, .bashrc, and .profile always; .bash_profile / .zprofile if they exist
    for _isf_rc in "$_isf_primary" "${HOME}/.bashrc" "${HOME}/.profile" \
                   "${HOME}/.bash_profile" "${HOME}/.zprofile"; do
        [ -f "$_isf_rc" ] || continue
        if grep -qF "skewed-emacs/shell-functions.sh" "$_isf_rc" 2>/dev/null; then
            log_info "Shell helpers already in ${_isf_rc} (no change needed)"
        else
            printf '\n# Skewed Emacs shell helpers\n%s\n' "$_isf_source_line" >> "$_isf_rc"
            log_success "Added skewed-emacs shell helpers to ${_isf_rc}"
            _isf_wrote=true
            _isf_wrote_files="${_isf_wrote_files:+${_isf_wrote_files}, }${_isf_rc}"
            SHELL_HELPERS_CHANGED=true
        fi
    done

    if [ "$_isf_wrote" = "true" ]; then
        log_info "Helpers wired into: ${_isf_wrote_files}"
        log_info "Open a new terminal (or run:  . ${_isf_file}  ) to activate eskew/egskew"
    fi
}

refresh_emacs_runtime_config() {
    _refresh_result="$(run_compose exec -T skewed-emacs emacsclient --eval \
        "(progn
            (defvar skewed-runtime-services-refresh-armed nil)
            (defvar skewed-runtime-services-refresh-done nil)
            (defun skewed-runtime-services-refresh ()
              (when (and (require 'services-discovery nil t)
                         (not skewed-runtime-services-refresh-done))
                (setq skewed-runtime-services-refresh-done t)
                (skewed-reload-services)
                (when (and (require 'dashboard nil t)
                           (get-buffer \"*dashboard*\"))
                  (with-current-buffer \"*dashboard*\"
                    (dashboard-refresh-buffer)))
                'ok))
            (unless skewed-runtime-services-refresh-armed
              (setq skewed-runtime-services-refresh-armed t)
              (with-eval-after-load 'services-discovery
                (skewed-runtime-services-refresh))
              (with-eval-after-load 'dashboard
                (skewed-runtime-services-refresh)))
            (or (skewed-runtime-services-refresh) 'deferred))" 2>/dev/null || true)"

    case "$_refresh_result" in
        *ok*)
            log_success "Reloaded generated services in the running Emacs session"
            ;;
        *deferred*)
            log_info "Queued a final Emacs service refresh after startup completes"
            ;;
        "")
            log_info "Skipped immediate Emacs service refresh; the daemon is still initializing"
            ;;
        *)
            log_warning "Emacs service reload hook failed: ${_refresh_result}"
            ;;
    esac
}

show_skew_welcome() {
    echo ""
    echo "Services are Up.  The complement is aboard."
    echo ""
    echo "Shell Commands for the Basilisk Stack"
    echo ""
    printf "%b\n" "  \`eskew\`  ${BLUE}-- terminal emacsclient (attach in current terminal)${NC}"
    printf "%b\n" "  \`egskew\` ${BLUE}-- graphical emacsclient (opens new window)${NC}"
    echo ""
    echo "NOTE: Please exit this shell with Ctrl-D before doing './basilisk down'."
    echo "      (A down + up is a relief in place: same ship, all-new crew.)"
    echo ""
}

# =============================================================================
# MAIN
# =============================================================================
main() {
    # Variant switches: pick the skewed-emacs image variant for this
    # invocation (same names as docker/build targets).  They set
    # EMACS_IMAGE_VARIANT, which the compose image tag interpolates;
    # a shell-exported value wins over .env.  Works with any command
    # that touches images (up, pull, restart, config, ...).
    _remaining=""
    for _arg in "$@"; do
        case "$_arg" in
            --lite)              EMACS_IMAGE_VARIANT=lite ;;
            --default)           EMACS_IMAGE_VARIANT=default ;;
            --tui|--aituis)      EMACS_IMAGE_VARIANT=tui ;;
            --gui)               EMACS_IMAGE_VARIANT=gui ;;
            --full|--gui-aituis) EMACS_IMAGE_VARIANT=full ;;
            *) _remaining="${_remaining:+$_remaining
}$_arg" ;;
        esac
    done
    if [ -n "${EMACS_IMAGE_VARIANT:-}" ]; then
        export EMACS_IMAGE_VARIANT
        log_info "skewed-emacs image variant: ${EMACS_IMAGE_VARIANT}"
    fi
    # Rebuild positional args minus the variant switches (newline
    # delimiter so service names with spaces would still be wrong, but
    # compose service names cannot contain spaces).
    if [ -n "$_remaining" ]; then
        _old_ifs=$IFS; IFS='
'
        # shellcheck disable=SC2086
        set -- $_remaining
        IFS=$_old_ifs
    else
        set --
    fi

    case "${1:-help}" in
        help|--help|-h) ;;
        *) preflight_checks || exit 1 ;;
    esac

    check_docker_compose

    case "${1:-help}" in
        up)
            shift
            _up_daemon=false
            _up_remaining=""
            for _up_arg in "$@"; do
                case "$_up_arg" in
                    --daemon|-d) _up_daemon=true ;;
                    --pull)      PULL_ALWAYS=1 ;;
                    *)           _up_remaining="${_up_remaining:+$_up_remaining }$_up_arg" ;;
                esac
            done
            # shellcheck disable=SC2086  (word-split intentional: service names)
            start_services $_up_remaining
            _up_rc=$?

            if [ "$_up_daemon" = "false" ]; then
                install_shell_functions
                if [ "$SHELL_HELPERS_CHANGED" = "true" ]; then
                    show_skew_welcome
                    exec "${SHELL:-sh}" -i
                fi
            fi
            # Propagate validation failure (systemd oneshot units watch
            # this exit status; the old code always exited 0 under -d).
            [ "$_up_rc" -eq 0 ] || exit "$_up_rc"
            ;;
        down)   stop_services ;;
        restart) shift; restart_services "$@" ;;
        stop)   shift; run_compose stop "$@" ;;
        logs)   shift; show_logs "$@" ;;
        status|ps) show_status ;;
        emacs)  connect_emacs ;;
        pull)   pull_images ;;
        clean)  clean_all ;;
        install-shell-functions) install_shell_functions ;;
        init)
            init_env
            ensure_env
            log_success "Environment initialized"
            ;;
        config) show_config ;;
        help|--help|-h) show_help ;;
        *)
            log_error "Unknown command: $1"
            printf "Use '%s help' for usage information\n" "$0"
            exit 1
            ;;
    esac
}

main "$@"
