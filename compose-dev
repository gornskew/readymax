# =============================================================================
# SERVICE MANAGEMENT
# =============================================================================
start_services() {
    _ss_services="$*"
    init_env
    ensure_env

    # Ensure AI TUI auth placeholder files exist on host.
    # (Docker bind-mounts create directories for missing files, breaking TUIs.)
    for _auth_file in \
        "${HOME}/.claude/.credentials.json" \
        "${HOME}/.gemini/google_accounts.json" \
        "${HOME}/.gemini/oauth_creds.json" \
        "${HOME}/.codex/auth.json" \
        "${HOME}/.grok/auth.json"
    do
        if [ ! -f "$_auth_file" ]; then
            mkdir -p "$(dirname "$_auth_file")"
            touch "$_auth_file"
            log_info "Created placeholder: $_auth_file"
        fi
    done

    pull_images

    log_info "Starting services: ${_ss_services:-all}"
    # shellcheck disable=SC2086  (word-split intentional: service names)
    run_compose up -d $_ss_services

    # ---- MCP config merge ----
    log_info "Preparing MCP configurations (JSON + TOML)..."

    # Step 1: Copy overlay MCP config files into container
    for _overlay in \
        "${SCRIPT_DIR}/mcp/"*-mcp-windows.json \
        "${SCRIPT_DIR}/mcp/"*-mcp-container.json \
        "${SCRIPT_DIR}/mcp/"*-mcp.toml
    do
        [ -f "$_overlay" ] || continue
        log_info "Copying overlay: $(basename "$_overlay")"
        run_compose cp "$_overlay" \
            skewed-emacs:/home/emacs-user/skewed-emacs/mcp/ 2>/dev/null || true
    done

    # Step 1b: Copy overlay services-generated Emacs files, PLUS
    # services-discovery.el -- the discovery/merge logic and the
    # generated files are a matched pair (sparse overlay entries rely
    # on key-wise merging in discovery).  Syncing one without the
    # other skews them when the running image predates a discovery
    # change (bit us 2026-08-09: gendl-ccl vanished from the dashboard
    # Swank list on a stale image + fresh sparse overlay).
    for _overlay in "${SCRIPT_DIR}/dot-files/emacs.d/etc/"*-services-generated.el \
                    "${SCRIPT_DIR}/dot-files/emacs.d/etc/services-discovery.el"; do
        [ -f "$_overlay" ] || continue
        log_info "Copying overlay: $(basename "$_overlay")"
        run_compose cp "$_overlay" \
            skewed-emacs:/home/emacs-user/skewed-emacs/dot-files/emacs.d/etc/ 2>/dev/null || true
    done

    # Step 2: Merge inside container. This writes merged MCP config files and
    # updates /home/emacs-user/.codex/config.toml and ~/.grok/config.toml.
    MCP_MERGE_SUCCESS=false
    _attempt=1
    while [ "$_attempt" -le 5 ]; do
        if run_compose exec -T skewed-emacs emacsclient --eval \
            "(progn (setenv \"SKEWED_CLONE_PATH\" \"${SCRIPT_DIR}\")
                    (load-file \"/home/emacs-user/skewed-emacs/mcp/merge-mcp-configs.el\")
                    (skewed-merge-all-mcp-configs \"/home/emacs-user/skewed-emacs/mcp\"))" \
            > /dev/null 2>&1
        then
            MCP_MERGE_SUCCESS=true
            break
        fi
        if [ "$_attempt" -lt 5 ]; then
            log_info "Waiting for emacs daemon (attempt $_attempt/5)..."
            sleep 2
        fi
        _attempt=$((_attempt + 1))
    done

    if [ "$MCP_MERGE_SUCCESS" = true ]; then
        log_success "MCP configurations merged for container CLI, Windows, Codex, and Grok"

        # Copy the platform-appropriate Claude Desktop config back to the
        # host clone (regression fix: the pre-POSIX compose-dev did this).
        # WSL hosts get the wsl-wrapped config; Linux/macOS get the native one.
        if grep -qi microsoft /proc/version 2>/dev/null; then
            _cdc_src="/tmp/merged-mcp-windows.json"
        else
            _cdc_src="/tmp/merged-mcp-host.json"
        fi
        if run_compose cp "skewed-emacs:${_cdc_src}" \
            "${SCRIPT_DIR}/mcp/claude_desktop_config.json" 2>/dev/null; then
            log_success "Claude Desktop config ready: mcp/claude_desktop_config.json (see docs/CLAUDE_DESKTOP.md)"
        else
            log_warning "Could not copy Claude Desktop config from container"
            log_warning "(an older skewed-emacs image may not generate ${_cdc_src};"
            log_warning " try './compose-dev up --pull' to fetch the latest image)"
        fi
    else
        log_warning "MCP configuration merge did not complete; Emacs daemon may still be starting"
    fi

    refresh_emacs_runtime_config

    # Catch alive-but-dead startups (CCL ASLR "exception 11" hangs
    # etc.) before declaring the stack up; restarts flunkers.
    verify_service_health
}

stop_services() {
    log_info "Stopping all services"
    run_compose down
}

restart_services() {
    log_info "Restarting services: ${*:-all}"
    run_compose restart "$@"
    verify_service_health
}

# =============================================================================
# POST-UP HEALTH WATCHDOG
#
# CCL occasionally loses its ASLR dice roll at startup ("exception 11"
# in the kernel debugger): the process does not exit -- it hangs -- so
# `restart: unless-stopped` never fires and the container sits there
# "running" while its healthcheck flunks (observed on balaram
# 2026-08-11: all gendl-ccl-served sites 404'd through cyclops).
# autoheal (base compose, since 2026-07-26) restarts unhealthy
# containers continuously, but a hang at `up` time deserves immediate
# detection, an immediate restart, and a loud report right here at the
# console.  This applies to any container with a healthcheck: a
# restart re-rolls the dice, so a couple of retries normally clears
# transient startup wedges.
#
# Tunables (env): HEALTH_WAIT_SECS (default 180) overall deadline;
# HEALTH_MAX_RESTARTS (default 2) per-container restart budget.
# =============================================================================
verify_service_health() {
    _vh_deadline="${HEALTH_WAIT_SECS:-180}"
    _vh_budget="${HEALTH_MAX_RESTARTS:-2}"
    _vh_ids="$(run_compose ps -q 2>/dev/null)"
    [ -n "$_vh_ids" ] || return 0

    # Containers that define a healthcheck, as "name" per line.
    _vh_watched=""
    for _vh_id in $_vh_ids; do
        _vh_line="$(docker inspect --format \
            '{{.Name}} {{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
            "$_vh_id" 2>/dev/null)" || continue
        case "$_vh_line" in
            *" none") ;;
            *) _vh_name="${_vh_line%% *}"
               _vh_watched="${_vh_watched:+$_vh_watched
}${_vh_name#/}" ;;
        esac
    done
    [ -n "$_vh_watched" ] || return 0

    log_info "Waiting up to ${_vh_deadline}s for health: $(printf '%s' "$_vh_watched" | tr '\n' ' ')"

    _vh_elapsed=0
    while :; do
        _vh_pending=""
        for _vh_name in $_vh_watched; do
            _vh_status="$(docker inspect --format \
                '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' \
                "$_vh_name" 2>/dev/null)" || _vh_status="missing"
            case "$_vh_status" in
                healthy|none) ;;
                unhealthy)
                    # Per-container restart counter without arrays:
                    # sanitized name -> shell variable via eval.
                    _vh_var="_vh_rc_$(printf '%s' "$_vh_name" | tr -c 'a-zA-Z0-9' '_')"
                    eval "_vh_count=\${${_vh_var}:-0}"
                    if [ "$_vh_count" -lt "$_vh_budget" ]; then
                        eval "${_vh_var}=$((_vh_count + 1))"
                        log_warning "${_vh_name} is unhealthy (hung startup?) -- restarting ($((_vh_count + 1))/${_vh_budget})"
                        docker restart "$_vh_name" >/dev/null 2>&1 || \
                            log_error "docker restart ${_vh_name} failed"
                    fi
                    _vh_pending="${_vh_pending} ${_vh_name}"
                    ;;
                *)  # starting / missing
                    _vh_pending="${_vh_pending} ${_vh_name}"
                    ;;
            esac
        done

        [ -z "$_vh_pending" ] && {
            log_success "All healthchecked services are healthy"
            return 0
        }
        [ "$_vh_elapsed" -ge "$_vh_deadline" ] && break
        sleep 5
        _vh_elapsed=$((_vh_elapsed + 5))
    done

    log_error "Not healthy after ${_vh_deadline}s:${_vh_pending}"
    for _vh_name in $_vh_pending; do
        log_error "--- last log lines from ${_vh_name}:"
        docker logs --tail 5 "$_vh_name" 2>&1 | sed 's/^/    /'
    done
    log_error "autoheal (if running) will keep retrying; investigate with: docker logs <name>"
    return 1
}

show_logs() {
    run_compose logs -f "$@"
}

show_status() {
    log_info "Service status:"
    run_compose ps
}

connect_emacs() {
    log_info "Connecting to Emacs via emacsclient"
    run_compose exec skewed-emacs emacsclient -t
}

pull_images() {
    if [ -n "${NO_PULL}" ]; then
        log_info "Skipping pull (NO_PULL set)"
        return
    fi

    if [ -n "${PULL_ALWAYS}" ]; then
        log_info "Pulling latest images (PULL_ALWAYS set)"
        run_compose pull
        return
    fi

    log_info "Pulling missing images only"

    _svc_img_pairs="$(
        run_compose config | awk '
            $1 == "services:" { in_services=1; next }
            in_services && match($0, /^[[:space:]]{2}[A-Za-z0-9_-]+:$/) {
                service=$1; sub(":", "", service); next
            }
            in_services && $1 == "image:" { print service, $2 }
        '
    )"

    _missing=""
    while IFS=" " read -r _svc _img; do
        [ -z "$_svc" ] || [ -z "$_img" ] && continue
        if docker image inspect "$_img" > /dev/null 2>&1; then
            log_info "Image present locally, skipping pull: $_svc ($_img)"
        else
            _missing="${_missing:+$_missing }$_svc"
        fi
    done << _PAIRS
$_svc_img_pairs
_PAIRS

    if [ -z "$_missing" ]; then
        log_success "All images present locally; skipping pull"
        return
    fi

    log_info "Pulling missing services: $_missing"
    # shellcheck disable=SC2086  (word-split intentional: service names)
    run_compose pull $_missing
}

clean_all() {
    log_warning "This will remove containers, networks, and unused images (including pulled ones)"
    printf "Are you sure? (y/N): "
    read -r REPLY
    case "$REPLY" in
        [Yy]*)
            log_info "Cleaning up..."
            run_compose down --rmi all --volumes --remove-orphans
            docker system prune -f
            log_success "Cleanup complete"
            ;;
        *)
            log_info "Cleanup cancelled"
            ;;
    esac
}

show_config() {
    log_info "Showing merged Docker Compose configuration"
    run_compose config
}

# =============================================================================
# SHELL FUNCTION INSTALLATION
#
# Detects the user's login shell and writes to the appropriate RC file(s).
# Supports bash (.bashrc), zsh (.zshrc), and generic POSIX (.profile).
# Also updates .bash_profile / .zprofile if they already exist (macOS).
# =============================================================================
install_shell_functions() {
    _isf_dir="${HOME}/.config/skewed-emacs"
    _isf_file="${_isf_dir}/shell-functions.sh"
    SHELL_HELPERS_CHANGED=false

    mkdir -p "${_isf_dir}"
    _isf_tmp="${_isf_dir}/shell-functions.sh.tmp.$$"

    # The snippet is pure POSIX sh -- works when sourced from any shell.
    cat > "${_isf_tmp}" << 'SNIPPET'
# Skewed Emacs shell helpers - auto-generated by compose-dev
# Works in bash, zsh, sh, or any POSIX-compatible shell.

eskew() {
    docker exec -it --detach-keys "ctrl-^" skewed-emacs emacsclient -t "$@"
}

egskew() {
    if [ -n "$DISPLAY" ] || [ -n "$WAYLAND_DISPLAY" ]; then
        docker exec -i -e DISPLAY="$DISPLAY" -e WAYLAND_DISPLAY="$WAYLAND_DISPLAY" \
            --detach-keys "ctrl-^" skewed-emacs emacsclient -c "$@" &
    else
        docker exec -it --detach-keys "ctrl-^" skewed-emacs emacsclient -t "$@"
    fi
}
SNIPPET

    if [ -f "${_isf_file}" ] && cmp -s "${_isf_tmp}" "${_isf_file}"; then
        rm -f "${_isf_tmp}"
        log_info "Shell functions already up to date in ${_isf_file}"
    else
        mv "${_isf_tmp}" "${_isf_file}"
        SHELL_HELPERS_CHANGED=true
        log_success "Shell functions written to ${_isf_file}"
    fi

    # Use '.' not 'source' -- POSIX portable
    _isf_source_line=". \"${_isf_file}\""

    # Primary RC based on login shell
    case "${SHELL##*/}" in
        zsh)  _isf_primary="${HOME}/.zshrc" ;;
        bash) _isf_primary="${HOME}/.bashrc" ;;
        ksh)  _isf_primary="${HOME}/.kshrc" ;;
        *)    _isf_primary="${HOME}/.profile" ;;
    esac

    # Belt and suspenders for fresh machines: login and non-login shells
    # read different RC files (.profile vs .bashrc), and a fresh account may
    # have SHELL=/bin/sh.  Ensure both .bashrc and .profile carry the source
    # line; the grep guard below keeps this idempotent.
    touch "$_isf_primary" "${HOME}/.bashrc" "${HOME}/.profile" 2>/dev/null || true

    _isf_wrote=false
    _isf_wrote_files=""
    # Write to primary, .bashrc, and .profile always; .bash_profile / .zprofile if they exist
    for _isf_rc in "$_isf_primary" "${HOME}/.bashrc" "${HOME}/.profile" \
                   "${HOME}/.bash_profile" "${HOME}/.zprofile"; do
        [ -f "$_isf_rc" ] || continue
        if grep -qF "skewed-emacs/shell-functions.sh" "$_isf_rc" 2>/dev/null; then
            log_info "Shell helpers already in ${_isf_rc} (no change needed)"
        else
            printf '\n# Skewed Emacs shell helpers\n%s\n' "$_isf_source_line" >> "$_isf_rc"
            log_success "Added skewed-emacs shell helpers to ${_isf_rc}"
            _isf_wrote=true
            _isf_wrote_files="${_isf_wrote_files:+${_isf_wrote_files}, }${_isf_rc}"
            SHELL_HELPERS_CHANGED=true
        fi
    done

    if [ "$_isf_wrote" = "true" ]; then
        log_info "Helpers wired into: ${_isf_wrote_files}"
        log_info "Open a new terminal (or run:  . ${_isf_file}  ) to activate eskew/egskew"
    fi
}

refresh_emacs_runtime_config() {
    _refresh_result="$(run_compose exec -T skewed-emacs emacsclient --eval \
        "(progn
            (defvar skewed-runtime-services-refresh-armed nil)
            (defvar skewed-runtime-services-refresh-done nil)
            (defun skewed-runtime-services-refresh ()
              (when (and (require 'services-discovery nil t)
                         (not skewed-runtime-services-refresh-done))
                (setq skewed-runtime-services-refresh-done t)
                (skewed-reload-services)
                (when (and (require 'dashboard nil t)
                           (get-buffer \"*dashboard*\"))
                  (with-current-buffer \"*dashboard*\"
                    (dashboard-refresh-buffer)))
                'ok))
            (unless skewed-runtime-services-refresh-armed
              (setq skewed-runtime-services-refresh-armed t)
              (with-eval-after-load 'services-discovery
                (skewed-runtime-services-refresh))
              (with-eval-after-load 'dashboard
                (skewed-runtime-services-refresh)))
            (or (skewed-runtime-services-refresh) 'deferred))" 2>/dev/null || true)"

    case "$_refresh_result" in
        *ok*)
            log_success "Reloaded generated services in the running Emacs session"
            ;;
        *deferred*)
            log_info "Queued a final Emacs service refresh after startup completes"
            ;;
        "")
            log_info "Skipped immediate Emacs service refresh; the daemon is still initializing"
            ;;
        *)
            log_warning "Emacs service reload hook failed: ${_refresh_result}"
            ;;
    esac
}

show_skew_welcome() {
    echo ""
    echo "Services are Up."
    echo ""
    echo "Shell Commands for the Skewed Emacs Stack"
    echo ""
    printf "%b\n" "  \`eskew\`  ${BLUE}-- terminal emacsclient (attach in current terminal)${NC}"
    printf "%b\n" "  \`egskew\` ${BLUE}-- graphical emacsclient (opens new window)${NC}"
    echo ""
    echo "NOTE: Please exit this shell with Ctrl-D before doing './compose-dev down'."
    echo ""
}

# =============================================================================
# MAIN
# =============================================================================
main() {
    # Variant switches: pick the skewed-emacs image variant for this
    # invocation (same names as docker/build targets).  They set
    # EMACS_IMAGE_VARIANT, which the compose image tag interpolates;
    # a shell-exported value wins over .env.  Works with any command
    # that touches images (up, pull, restart, config, ...).
    _remaining=""
    for _arg in "$@"; do
        case "$_arg" in
            --lite)              EMACS_IMAGE_VARIANT=lite ;;
            --default)           EMACS_IMAGE_VARIANT=default ;;
            --tui|--aituis)      EMACS_IMAGE_VARIANT=tui ;;
            --gui)               EMACS_IMAGE_VARIANT=gui ;;
            --full|--gui-aituis) EMACS_IMAGE_VARIANT=full ;;
            *) _remaining="${_remaining:+$_remaining
}$_arg" ;;
        esac
    done
    if [ -n "${EMACS_IMAGE_VARIANT:-}" ]; then
        export EMACS_IMAGE_VARIANT
        log_info "skewed-emacs image variant: ${EMACS_IMAGE_VARIANT}"
    fi
    # Rebuild positional args minus the variant switches (newline
    # delimiter so service names with spaces would still be wrong, but
    # compose service names cannot contain spaces).
    if [ -n "$_remaining" ]; then
        _old_ifs=$IFS; IFS='
'
        # shellcheck disable=SC2086
        set -- $_remaining
        IFS=$_old_ifs
    else
        set --
    fi

    case "${1:-help}" in
        help|--help|-h) ;;
        *) preflight_checks || exit 1 ;;
    esac

    check_docker_compose

    case "${1:-help}" in
        up)
            shift
            _up_daemon=false
            _up_remaining=""
            for _up_arg in "$@"; do
                case "$_up_arg" in
                    --daemon|-d) _up_daemon=true ;;
                    --pull)      PULL_ALWAYS=1 ;;
                    *)           _up_remaining="${_up_remaining:+$_up_remaining }$_up_arg" ;;
                esac
            done
            # shellcheck disable=SC2086  (word-split intentional: service names)
            start_services $_up_remaining

            if [ "$_up_daemon" = "false" ]; then
                install_shell_functions
                if [ "$SHELL_HELPERS_CHANGED" = "true" ]; then
                    show_skew_welcome
                    exec "${SHELL:-sh}" -i
                fi
            fi
            ;;
        down)   stop_services ;;
        restart) shift; restart_services "$@" ;;
        stop)   shift; run_compose stop "$@" ;;
        logs)   shift; show_logs "$@" ;;
        status|ps) show_status ;;
        emacs)  connect_emacs ;;
        pull)   pull_images ;;
        clean)  clean_all ;;
        install-shell-functions) install_shell_functions ;;
        init)
            init_env
            ensure_env
            log_success "Environment initialized"
            ;;
        config) show_config ;;
        help|--help|-h) show_help ;;
        *)
            log_error "Unknown command: $1"
            printf "Use '%s help' for usage information\n" "$0"
            exit 1
            ;;
    esac
}

main "$@"
