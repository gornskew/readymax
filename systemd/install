#!/bin/sh
# Install skewed-emacs as a systemd service on the current machine.
#
# Substitutes %%USER%% with the invoking user and derives SKEWED_DIR
# from the script's own location (../ relative to systemd/).
#
# Usage (run as the user who will own the service, with sudo available):
#
#   cd /path/to/skewed-emacs
#   sh systemd/install
#
# Pick a non-full image variant for the service (injected as an
# Environment= line; compose-dev init then pins it in .env):
#
#   SKEWED_VARIANT=default sh systemd/install
#
# Or, to override user/dir explicitly:
#
#   SKEWED_USER=dave SKEWED_DIR=/home/dave/projects/skewed-emacs \
#     sh systemd/install

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# TEMPLATE override lets stack repos install their host-specific unit
# (variant-pinned) under the same service name, replacing any legacy
# install:  TEMPLATE=/path/to/stack/systemd/skewed-emacs.service \
#             sh systemd/install
TEMPLATE="${TEMPLATE:-${SCRIPT_DIR}/skewed-emacs.service}"
SERVICE_NAME="skewed-emacs"
SYSTEMD_DIR="${SYSTEMD_DIR:-/etc/systemd/system}"

# ---- Stack-vs-factory clash guard -------------------------------------------
# A unit carrying an EMACS_IMAGE_VARIANT pin was installed by a *-stack
# repo (host-specific IaC).  Installing the unpinned factory template
# over it would silently drop the host's variant pin -- refuse unless
# forced.  Stack-template installs (pinned templates) may always
# replace: that takeover is the intended direction.
EXISTING_UNIT="${SYSTEMD_DIR}/${SERVICE_NAME}.service"
if [ -f "${EXISTING_UNIT}" ] \
   && grep -q "EMACS_IMAGE_VARIANT" "${EXISTING_UNIT}" \
   && ! grep -q "EMACS_IMAGE_VARIANT" "${TEMPLATE}" \
   && [ -z "${SKEWED_VARIANT:-}" ] \
   && [ "${FORCE:-0}" != "1" ]; then
    existing_pin=$(sed -n 's/^Environment=EMACS_IMAGE_VARIANT=//p' "${EXISTING_UNIT}" | head -1)
    echo "ERROR: ${EXISTING_UNIT} is a stack-installed unit (variant pin: ${existing_pin:-unknown})."
    echo "       Installing the factory template would drop this host's pin."
    echo "       Use the stack repo's installer instead:  sh <host>-stack/systemd/install"
    echo "       Or override deliberately:  FORCE=1 sh systemd/install"
    exit 1
fi

# Optional image-variant pin for the factory template (stack templates
# carry their own pin; SKEWED_VARIANT is refused there to avoid two
# Environment= lines fighting).
if [ -n "${SKEWED_VARIANT:-}" ]; then
    case "${SKEWED_VARIANT}" in
        lite|default|tui|aituis|gui|full|gui-aituis) ;;
        *) echo "ERROR: SKEWED_VARIANT must be one of: lite default tui aituis gui full gui-aituis"; exit 1 ;;
    esac
    if grep -q "EMACS_IMAGE_VARIANT" "${TEMPLATE}"; then
        echo "ERROR: template ${TEMPLATE} already pins EMACS_IMAGE_VARIANT; unset SKEWED_VARIANT"
        exit 1
    fi
fi

# ---- Resolve user and skewed-emacs directory --------------------------------

SKEWED_USER="${SKEWED_USER:-$(logname 2>/dev/null || echo "${USER:-$(id -un)}" )}"
SKEWED_DIR="${SKEWED_DIR:-$(cd "${SCRIPT_DIR}/.." && pwd)}"

echo "=== Skewed Emacs systemd deploy ==="
echo "  User       : ${SKEWED_USER}"
echo "  Skewed dir : ${SKEWED_DIR}"
echo "  Service    : ${SYSTEMD_DIR}/${SERVICE_NAME}.service"
echo ""

# ---- Preflight checks -------------------------------------------------------

if [ ! -f "${TEMPLATE}" ]; then
    echo "ERROR: Template not found: ${TEMPLATE}"; exit 1
fi

if [ ! -x "${SKEWED_DIR}/compose-dev" ]; then
    echo "ERROR: compose-dev not found/executable at ${SKEWED_DIR}/compose-dev"; exit 1
fi

if ! id "${SKEWED_USER}" > /dev/null 2>&1; then
    echo "ERROR: User ${SKEWED_USER} does not exist"; exit 1
fi

if ! groups "${SKEWED_USER}" 2>/dev/null | grep -qw docker; then
    echo "WARNING: ${SKEWED_USER} is not in the docker group."
    echo "         Add with: usermod -aG docker ${SKEWED_USER}"
fi

# ---- Substitute template and install ----------------------------------------

UNIT_CONTENT=$(sed \
    -e "s|%%USER%%|${SKEWED_USER}|g" \
    -e "s|/home/%%USER%%/projects/skewed-emacs|${SKEWED_DIR}|g" \
    "${TEMPLATE}")

if [ -n "${SKEWED_VARIANT:-}" ]; then
    UNIT_CONTENT=$(printf '%s\n' "${UNIT_CONTENT}" | sed \
        "s|^Environment=HOME=.*|&\nEnvironment=EMACS_IMAGE_VARIANT=${SKEWED_VARIANT}|")
    echo "Pinning image variant in unit: ${SKEWED_VARIANT}"
fi

if [ -f "${SYSTEMD_DIR}/${SERVICE_NAME}.service" ]; then
    echo "--- Existing service (will be replaced) ---"
    cat "${SYSTEMD_DIR}/${SERVICE_NAME}.service"
    echo ""
fi

printf '%s\n' "${UNIT_CONTENT}" | sudo tee "${SYSTEMD_DIR}/${SERVICE_NAME}.service" > /dev/null
echo "Wrote ${SYSTEMD_DIR}/${SERVICE_NAME}.service"

sudo systemctl daemon-reload
sudo systemctl enable "${SERVICE_NAME}"
echo "Enabled ${SERVICE_NAME} (starts on boot)"

# ---- Optionally start now ---------------------------------------------------

if systemctl is-active --quiet "${SERVICE_NAME}" 2>/dev/null; then
    echo ""
    echo "Service is already running. To apply changes:"
    echo "  sudo systemctl restart ${SERVICE_NAME}"
else
    echo ""
    printf "Start %s now? [y/N] " "${SERVICE_NAME}"
    read -r answer
    case "$answer" in
        [Yy]*)
            sudo systemctl start "${SERVICE_NAME}"
            echo "Waiting for containers..."
            sleep 10
            sudo systemctl status "${SERVICE_NAME}" --no-pager || true
            echo ""
            echo "Verify enterprise container health:"
            echo "  docker exec genworks-gdl-enterprise-smp curl -sf http://localhost:9098/lisply/ping-lisp"
            ;;
        *)
            echo "Start when ready: sudo systemctl start ${SERVICE_NAME}"
            ;;
    esac
fi

echo ""
echo "=== Done ==="
echo "Useful commands:"
echo "  sudo systemctl status ${SERVICE_NAME}"
echo "  sudo journalctl -u ${SERVICE_NAME} -f"
echo "  sudo systemctl stop|restart ${SERVICE_NAME}"
